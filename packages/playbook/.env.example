# ── Browser ──────────────────────────────────────────────────
BROWSER_WS_URL=ws://localhost:9222/session

# ── Recorder ─────────────────────────────────────────────────
POLL_INTERVAL_MS=1000
PLAYBOOK_OUTPUT_DIR=./playbooks

# ── LLM Providers ───────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
OLLAMA_URL=http://localhost:11434
# OLLAMA_CLOUD_URL=https://ollama.your-server.com
# OLLAMA_API_KEY=

# ── Router LLM (lightweight — interprets user commands) ─────
ROUTER_PROVIDER=ollama
ROUTER_MODEL=llama3.2
ROUTER_TEMPERATURE=0.0

# ── Transcriber LLM (session log → playbook JSON) ──────────
TRANSCRIBER_PROVIDER=ollama
TRANSCRIBER_MODEL=devstral-small-2:24b
TRANSCRIBER_TEMPERATURE=0.0

# ── 1Password (optional — for vault variable source) ────────
# Requires: op CLI v2.18.0+, a dedicated vault (not Private)
# Create: op service-account create "Playbook" --vault "Automation"
# Format: op://VaultName/ItemName/field
# OP_SERVICE_ACCOUNT_TOKEN=ops_...