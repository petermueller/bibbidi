# .env.example - Environment variables for Autopilot

# Browser Configuration
BROWSER=firefox
FIREFOX_WS_URL=ws://localhost:9222
CHROMEDRIVER_URL=http://localhost:9515

# Vision API (unified: YOLO + txtai + SAM3 + CAPTCHA + VLM)
VISION_URL=http://localhost:5001

# LLM Providers
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CLOUD_URL=
OLLAMA_API_KEY=

# Planner Configuration
PLANNER_PROVIDER=anthropic
PLANNER_MODEL=claude-sonnet-4-5-20250929
PLANNER_TEMPERATURE=0.0